# Copy these lines into your real .env file (never commit it: it contains secrets).

# --- Notifications ---------------------------------------------------------------
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=123456789:replace_with_token_from_BotFather
TELEGRAM_CHAT_ID=123456789

# --- Telegram Mini App (web app) -------------------------------------------------
# Turn the web app on:
COMPOSE_PROFILES=web
# Your domain (its A record must point to this server). No https://, no slash.
DOMAIN=monitor.example.com
# Who may open the app. Numeric Telegram IDs, comma separated.
# If empty, TELEGRAM_CHAT_ID is used when it is a private chat.
ADMIN_TELEGRAM_IDS=
# Optional: read-only users (can view containers, logs and history, but not control).
VIEWER_TELEGRAM_IDS=
